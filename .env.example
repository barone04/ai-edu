# Postgres connection string. Local: docker compose up -d db. Production: Neon pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bat_mach_lop_hoc"

# Anthropic API, server-side only. Leave the key empty to run with demo fixtures only.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Shared passcode teachers enter to open the app, and the secret used to sign the session cookie.
APP_PASSCODE=""
SESSION_SECRET=""
